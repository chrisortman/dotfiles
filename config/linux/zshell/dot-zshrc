is-macos() {
  [[ $OSTYPE == darwin* ]]
}

export EDITOR=vim
export HISTFILE=~/.zsh_history
export HISTSIZE=10000
export SAVEHIST=10000
setopt SHARE_HISTORY

# Ghostty shell integration for Zsh. Ghostty exports GHOSTTY_RESOURCES_DIR
# itself when it launches the shell; the rest are fallbacks. Guard on the file
# so a machine without Ghostty (a Linux VM lacking the Mac mount) stays quiet.
export GHOSTTY_SHELL_FEATURES="cursor,title"

for _ghostty_dir in \
  "$GHOSTTY_RESOURCES_DIR" \
  /Applications/Ghostty.app/Contents/Resources/ghostty \
  /usr/share/ghostty
do
  if [[ -r "${_ghostty_dir}/shell-integration/zsh/ghostty-integration" ]]; then
    export GHOSTTY_RESOURCES_DIR="$_ghostty_dir"
    source "${_ghostty_dir}/shell-integration/zsh/ghostty-integration"
    break
  fi
done
unset _ghostty_dir

source $HOME/.antidote/antidote.zsh

# initialize plugins statically with ~/.zsh_plugins.txt
antidote load

# zsh-utils completion styles
compstyle zshzoo

autoload -Uz promptinit && promptinit && prompt pure

_pure_os_icon=$([[ $(uname) == "Darwin" ]] && echo "🍎" || echo "🐧")
PROMPT='${_pure_os_icon} '$PROMPT


# Want to ignore my mac home directory version of this file on linux
# assumes that you have the same user name
export MISE_IGNORED_CONFIG_PATHS="/Users/$USER/.config/mise/config.toml"

export REPORTTIME=60

export PATH="${PATH}:$HOME/.local/bin"

eval "$(mise activate zsh)"
eval "$(fnox activate zsh)"

# zsh-vi-mode compatibility function for fzf
zvm_after_init() {
  if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --zsh)"
  fi
}

alias rc="bin/rails console"
alias bat="batcat"
alias fzp="fzf -m --preview 'batcat --color=always --style=numbers {}' --preview-window=right:60%"
alias claude-personal='CLAUDE_CONFIG_DIR=~/.claude-personal command claude'
alias aws1=~/.virtualenvs/awscliv1/bin/aws

mux() { "$(mise where ruby@3.4.9)/bin/tmuxinator" "$@"; }
# Function to report directory
__report_working_directory() {
    echo "orb" > /mnt/mac/tmp/last.txt
    echo $PWD > /mnt/mac/tmp/lastdir.txt
    printf '\e]7;file://%s%s\a' "$HOST" "$PWD"
}

# Add to precmd hook (runs before each prompt)
autoload -Uz add-zsh-hook
add-zsh-hook precmd __report_working_directory

# Override cd to report immediately
cd() {
    builtin cd "$@"
    __report_working_directory
}

foreground-vi() {
    fg %nvim || fg %vim
}

zle -N foreground-vi
bindkey '^Z' foreground-vi

function edit-last () {
  local cmd
  setopt local_options extended_glob
  for cmd in $history; do
    case $cmd in
      ((ls|(cvs|git|hg|svn) status)(| *)) :;;
      ("rg "*) nvim -q<(eval "$cmd --vimgrep"); return;;
      (edit-last) :;;
      (*) echo >&2 "The previous rg command is too old."; return 125;;
    esac
  done
}

